{
  "name": "ha-advent-calendar-card",
  "version": "0.18.8",
  "description": "Animierte Adventskalender-Karte für Home Assistant (Lovelace Custom Card)",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jenser1/ha-advent-calendar-card.git"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:full": "rollup -c --environment EDITION:full"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "happy-dom": "^21.0.3",
    "rollup": "^4.64.7",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
